{"documentCount":6,"nextId":12,"documentIds":{"6":"cookies.html","7":"privacy.html","8":"terms.html","9":"about.html","10":"index.html","11":"services.html"},"fieldIds":{"title":0,"aliases":1,"headers":2,"tags":3,"path":4,"content":5},"fieldLength":{"6":[1,1,1,1,4,393],"7":[2,1,7,1,4,639],"8":[2,1,2,1,4,805],"9":[1,1,125,1,4,202],"10":[1,1,40,1,4,140],"11":[1,1,29,1,4,139]},"averageFieldLength":[1.3333333333333333,1,34,1,4,386.3333333333333],"storedFields":{"6":{"title":"Cookies","aliases":[],"headers":["Cookies"],"tags":[],"path":"cookies.html"},"7":{"title":"Πολιτική απορρήτου","aliases":[],"headers":["Πολιτική απορρήτου και προστασίας προσωπικών δεδομένων GDPR"],"tags":[],"path":"privacy.html"},"8":{"title":"Όροι χρήσης","aliases":[],"headers":["Όροι χρήσης"],"tags":[],"path":"terms.html"},"9":{"title":"Εμείς","aliases":[],"headers":["Εμείς","Ασχολούμαστε με τη μελέτη και την κατασκευή κτιρίων αποφεύγοντας τις αρχιτεκτονικές 'μόδες'. Οργανώσαμε ένα τεχνικό γραφείο με σκοπό την ανθρωποκεντρική σχεδίαση των χώρων για να πλαισιώσουμε το εν τέλη αδιαίρετο των λειτουργικών και αισθητικών απαιτήσεων στέγασης.","Σχεδιάζουμε ικανοποιώντας τις παρούσες ανάγκες προβλέποντας τις μελλοντικές. Δίνουμε σημασία στους υπαίθριους χώρους και στη διαλεκτική του κτιρίου με τον περιβάλλον. Δεν χρησιμοποιούμε στοιχεία εντυπωσιασμού. Οι γραμμές μας απηχούν την προσωπικότητα του ιδιοκτήτη. Σχεδιάζουμε λιτά, λειτουργικά, καλαίσθητα και εργονομικά.","Κατασκευάζουμε με ποιότητα και ασφάλεια. Χρησιμοποιούμε πιστοποιημένα υλικά και έμπειρο εργατοτεχνικό προσωπικό.","Εκτός των Μελετών και των Κατασκευών, παρέχουμε όλο το πλαίσιο&nbsp;υπηρεσιών μηχανικού στον τομέα των ακινήτων.","Από τα τέλη του 2023 ξεκινήσαμε να δραστηριοποιούμαστε και στην εμπορία και ανάπτυξη λογισμικού για μηχανικούς, επιχειρήσεις και ιδιώτες.  Μπορείτε να δείτε περισσότερα στον ιστότοπό μας στη διεύθυνση&nbsp;<a data-tooltip-position=\"top\" aria-label=\"http://www.12358soft.com/\" rel=\"noopener nofollow\" class=\"external-link\" href=\"http://www.12358soft.com/\" target=\"_blank\">www.12358soft.com</a>"],"tags":[],"path":"about.html"},"10":{"title":"Αρχική","aliases":[],"headers":["Αρχική","Αντικείμενό μας είναι η μελέτη και η κατασκευή του χώρου που θα εξυπηρετήσει τις λειτουργικές και αισθητικές σας ανάγκες.","Η έκδοση της οικοδομικής αδείας που απαιτείται για την ανέγερση ή την ανακαίνιση.","Η έκδοση άδειας λειτουργίας της επιχείρησής σας.","Η ηλεκτρονική ταυτότητα, η ρύθμιση αυθαιρεσιών, η τοπογραφική μελέτη, η διακόσμηση και άλλα."],"tags":[],"path":"index.html"},"11":{"title":"Υπηρεσίες","aliases":[],"headers":["Υπηρεσίες","Μπορούμε να προσφέρουμε τις υπηρεσίες μας σε συνανθρώπους που αντιμετωπίζουν σοβαρά οικονομικά προβλήματα ή θέματα υγείας σε πολύ χαμηλές τιμές και με απόλυτη εχεμύθεια.","Μη διστάσετε να επικοινωνήσετε μαζί μας."],"tags":[],"path":"services.html"}},"dirtCount":6,"index":[["0",{"5":{"11":1}}],["view",{"5":{"11":1}}],["view19",{"5":{"11":1}}],["ξεκινήσαμε",{"2":{"9":1},"5":{"9":1}}],["θέματα",{"2":{"11":1},"5":{"11":1}}],["θίγει",{"5":{"8":2}}],["θίγονται",{"5":{"8":2}}],["θίγουν",{"5":{"8":2}}],["θεματα",{"5":{"7":2}}],["θα",{"2":{"10":1},"5":{"6":2,"7":8,"8":6,"10":1}}],["ωστόσο",{"5":{"8":6}}],["ωρών",{"5":{"7":2}}],["ως",{"5":{"7":8,"8":2}}],["72",{"5":{"7":2}}],["7",{"5":{"7":2}}],["5",{"5":{"7":2}}],["50",{"5":{"6":1,"7":1,"8":1,"9":1,"10":1,"11":1}}],["4",{"5":{"7":2}}],["3",{"5":{"7":2}}],["elements",{"5":{"11":1}}],["email",{"5":{"7":8}}],["external",{"2":{"9":1},"5":{"6":3,"7":4,"8":7,"9":1,"10":1,"11":1}}],["ζητηθείσας",{"5":{"8":2}}],["ζητά",{"5":{"8":2}}],["ζητάτε",{"5":{"7":2}}],["ζημιάς",{"5":{"7":2}}],["ζώσης",{"5":{"7":2}}],["ζωτικών",{"5":{"7":2}}],["ζωγράφου",{"5":{"6":2,"7":2,"8":4,"9":2,"10":2,"11":2}}],["name",{"5":{"11":1}}],["nametitlenone<br><a",{"5":{"11":1}}],["new",{"5":{"11":1}}],["newsletter",{"5":{"7":4}}],["nbsp",{"2":{"9":2}}],["none",{"5":{"11":1}}],["no",{"5":{"6":1,"7":1,"8":1,"9":1,"10":1,"11":1}}],["nofollow",{"2":{"